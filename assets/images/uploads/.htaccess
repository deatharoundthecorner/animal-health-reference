# Uploaded images must never be executed as code.
# (Defense in depth: the upload handler also only stores .jpg/.png/.webp files.)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "(?i)\.(php|phtml|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
